node_modules/
.sessions/
# pi 的隔离配置目录：里面有 auth.json（凭据）和模型目录缓存，绝不能提交
.pi-agent/
# 运行时落盘的图片附件
.attachments/
# 运行时配置：工作目录（绝对路径）+ 会话别名，属于本机状态，不是源码
.pixelagent.json
*.log
/p*.bin
/px*.bin
/shot*.png
/shot*.jpg
/shots/
/variants/layout/shots/
.bak/
.impeccable/

# 一次误写（`2>nul` 这种 cmd 写法在 bash 里会真的建出一个叫 nul 的文件）留下的产物。
# 注意：nul 是 Windows 保留设备名，普通删除 / 回收站都会报
# "指定的设备名无效 (0x800704B0)"，需要 \\?\ 扩展路径；这里选择忽略而不是删除。
/nul

# 吉祥物原图素材：tools/make-girl.js 的输入，产品只用抠好的 assets/girl.png
assets/girl-src.png

# 打包产物与内核缓存：vendor/pi 是 fetch-kernel.js 拉的 pi 内核（可重建），
# dist-app 是 electron-builder 输出
vendor/
dist-app/
# dist-app 被批量删除护栏拦下时，改名留的备份（同样可重建）
/dist-app.old-*

# 开发草稿：tools/_*.png 抠图中间产物、_ext-closure.json 闭包演算输出、
# ext-closure.js 是 pack-extensions.js 的原型（逻辑已并入，勿再改它）
tools/_*
# 临时备份文件（如 style.css.bak-20261011-pixdark）
*.bak-*
