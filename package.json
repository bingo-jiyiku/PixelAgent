{
  "name": "pixelagent",
  "version": "0.2.2",
  "description": "复古像素终端风桌面AI助手：Electron 前端 + pi 后端流式对话",
  "main": "main.js",
  "author": "DSH",
  "scripts": {
    "start": "electron .",
    "dist:kernel": "node tools/fetch-kernel.js",
    "pack:ext": "node tools/pack-extensions.js",
    "dist": "node tools/fetch-kernel.js && node tools/pack-extensions.js && electron-builder --win nsis && node tools/verify-dist.js",
    "dist:all": "node tools/fetch-kernel.js && node tools/pack-extensions.js && electron-builder --win nsis portable && node tools/verify-dist.js",
    "test": "node test/fixtures/load-image.js && node test/md.test.js && node test/parse.test.js && node test/pal.test.js && node test/bridge.test.js && node test/attach.test.js && node test/pathnotes.test.js && node test/extseed.test.js && node test/audit-copy.js",
    "test:fixtures": "node test/fixtures/load-image.js",
    "test:md": "node test/md.test.js",
    "test:parse": "node test/parse.test.js",
    "test:pal": "node test/pal.test.js",
    "test:bridge": "node test/bridge.test.js",
    "test:attach": "node test/attach.test.js",
    "audit:copy": "node test/audit-copy.js",
    "test:pi": "node test/pi-wire.test.js",
    "shot": "electron test/screenshot.js",
    "shot:extra": "electron test/shot-extra.js",
    "shot:settings": "electron test/shot-settings.js",
    "shot:model": "electron test/shot-model.js",
    "shot:girl": "electron test/shot-girl.js",
    "shot:sky": "electron test/shot-sky.js",
    "zoom:parts": "electron test/zoom-parts.js",
    "zoom:scene": "electron test/zoom-scene.js",
    "probe:scene": "electron test/probe-scene.js",
    "profile:girl": "node tools/girl-profile.js",
    "verify:tools": "electron test/verify-tools.js",
    "verify:features": "electron test/verify-features.js",
    "probe:trash": "electron test/probe-trash.js",
    "probe:usage": "electron test/probe-usage.js",
    "probe:mcfg": "electron test/probe-mcfg.js",
    "probe:esc": "electron test/probe-esc.js",
    "shot:welcome": "electron test/shot-welcome.js",
    "probe:migration": "electron test/probe-migration.js",
    "probe:exportfmt": "electron test/probe-exportfmt.js && electron test/probe-exportfmt.js --keep",
    "probe:extseed": "electron test/probe-extseed.js"
  },
  "license": "MIT",
  "build": {
    "appId": "com.dsh.pixelagent",
    "productName": "PixelAgent",
    "asar": true,
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "pi-bridge.js",
      "attach.js",
      "path-notes.js",
      "ext-seed.js",
      "preload.js",
      "renderer.js",
      "md.js",
      "parse.js",
      "pal.js",
      "index.html",
      "style.css",
      "assets/**/*",
      "!test",
      "!tools",
      "!shots",
      "!variants",
      "!vendor",
      "!dist-app",
      "!.sessions",
      "!.attachments",
      "!.pi",
      "!.pi-agent",
      "!.impeccable",
      "!.bak",
      "!.git",
      "!.gitignore",
      "!.pixelagent.json",
      "!*.png",
      "!*.jpg",
      "!*.bin",
      "!*.bak*",
      "!nul",
      "!README.md"
    ],
    "extraResources": [
      {
        "from": "vendor/pi/node_modules",
        "to": "pi/node_modules"
      },
      {
        "from": "ext",
        "to": "ext"
      },
      {
        "from": "vendor/ext-npm/node_modules",
        "to": "ext-npm/node_modules"
      },
      {
        "from": "vendor/ext-npm/pixelagent-extensions.json",
        "to": "ext-npm/pixelagent-extensions.json"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PixelAgent",
      "artifactName": "PixelAgent-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "PixelAgent-${version}-portable.exe",
      "unpackDirName": "PixelAgent"
    }
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0"
  }
}
